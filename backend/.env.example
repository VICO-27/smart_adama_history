APP_NAME="Smart Adama"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smart_adama
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=sa_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@smartadama.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI Providers — fill in your API keys
AI_LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

AI_EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite
VOYAGE_EMBEDDING_DIMENSION=1024

# Voyage AI Rate Limiting (free tier: 3 RPM, paid tier: higher)
# Adjust these if you have a paid Voyage account with higher limits
VOYAGE_REQUEST_DELAY_SECONDS=25
VOYAGE_RATE_LIMIT_RETRY_SECONDS=60

# RAG settings
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.75

# Rate limiting
CHAT_RATE_LIMIT_PER_5_MIN=20
